<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers usually speak plain http. Android cannot limit cleartext to private addresses, so it
     is allowed here, and every plain http connection the app opens refuses any other address
     (localCleartext, the Home Assistant sign-in page). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
