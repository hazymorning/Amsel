<?xml version="1.0" encoding="utf-8"?>
<!-- One button: one cell, as large as an app's icon. Any size, its form follows. Not on Android's update timer (updatePeriodMillis 0): Amsel draws it when what plays changes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.github.hazymorning.amsel.widget.WidgetSetupActivity"
    android:description="@string/widget_description_button"
    android:initialLayout="@layout/widget_tile"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_tile"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="31" />
