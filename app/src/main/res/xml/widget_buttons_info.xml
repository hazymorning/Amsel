<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons: two cells in one row. Drawn by Amsel whenever what plays changes, never on a timer; any size, its form follows. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.github.hazymorning.amsel.widget.WidgetSetupActivity"
    android:description="@string/widget_description_buttons"
    android:initialLayout="@layout/widget_row"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_row"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="31" />
