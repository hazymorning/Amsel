<?xml version="1.0" encoding="utf-8"?>
<!-- A bar's buttons: targets 52 dp wide side by side at its end, each showing a cell of 48 or,
     bare, its pressed shade. As it comes, the transport. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_slot_1"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light">

        <ImageView
            android:id="@+id/widget_glyph_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_2"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_play_light">

        <ImageView
            android:id="@+id/widget_glyph_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            android:tint="@color/widget_on_disc_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_3"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light">

        <ImageView
            android:id="@+id/widget_glyph_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_4"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_5"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_5"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_6"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_6"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_6"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_7"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_7"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_7"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_8"
        android:layout_width="@dimen/widget_bar_cell"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_8"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
