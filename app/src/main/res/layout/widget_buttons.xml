<?xml version="1.0" encoding="utf-8"?>
<!-- The buttons: touch targets of equal width side by side, each showing its cell half a gap inside
     it (widget_cell_*), so the layout itself keeps cells and gaps even at any size the launcher
     gives. As it comes, the transport. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_slot_1"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_light">

        <ImageView
            android:id="@+id/widget_glyph_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_2"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_play_light">

        <ImageView
            android:id="@+id/widget_glyph_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            android:tint="@color/widget_on_disc_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_3"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_light">

        <ImageView
            android:id="@+id/widget_glyph_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_slot_4"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_light"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_glyph_4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_speaker"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face_4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
