<?xml version="1.0" encoding="utf-8"?>
<!-- A bar's or a player's cover, in Amsel's cover corners (drawn into the picture); while nothing
     plays, the cover's shape in the shade's colour with the song's glyph, as on the dock. One box,
     not a merge: the widget pads it to stand the cover on its inset. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_art_box"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="MergeRootFrame">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- The cover's shape over it, tinted at night only. -->
    <ImageView
        android:id="@+id/widget_art_night"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:tint="@color/widget_night_tone"
        android:tintMode="src_in"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_art_blank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:tint="@color/widget_ground_light"
        android:tintMode="src_in" />

    <!-- 4 dp of room around the glyph, so its ink can move to the middle (WidgetViews). -->
    <ImageView
        android:id="@+id/widget_art_glyph"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_track"
        android:tint="@color/widget_quiet_light"
        android:tintMode="src_in" />

    <ImageView
        android:id="@+id/widget_art_glyph_large"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_track_light"
        android:tint="@color/widget_quiet_light"
        android:tintMode="src_in"
        android:visibility="gone" />
</FrameLayout>
