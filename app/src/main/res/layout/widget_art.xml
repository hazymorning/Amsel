<?xml version="1.0" encoding="utf-8"?>
<!-- A FrameLayout, not <merge>: widget_art_box holds the cover and its placeholders. fitStart keeps
     the cover at the top when a launcher draws the widget taller than it reported. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_art_box"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:visibility="gone" />

    <!-- The night tint over the cover: the blank shape in widget_night_tone, transparent by day. -->
    <ImageView
        android:id="@+id/widget_art_night"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:tint="@color/widget_night_tone"
        android:tintMode="src_in"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_art_blank"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:tint="@color/widget_cell_light"
        android:tintMode="src_in" />

    <!-- The 4dp padding lets WidgetDrawing shift the glyph to centre its visible bounds (ART_GLYPH_ROOM). -->
    <ImageView
        android:id="@+id/widget_art_glyph"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_track"
        android:tint="@color/widget_quiet_light"
        android:tintMode="src_in" />

    <ImageView
        android:id="@+id/widget_art_glyph_large"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_track_light"
        android:tint="@color/widget_quiet_light"
        android:tintMode="src_in"
        android:visibility="gone" />
</FrameLayout>
