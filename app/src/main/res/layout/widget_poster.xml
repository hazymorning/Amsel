<?xml version="1.0" encoding="utf-8"?>
<!-- Two cells wide and tall enough: the cover across the frame, what plays under it, a row of
     cells at the foot, as a small player stands. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: a launcher inflates only the classes widgets may use. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <!-- widget_art's views, across the frame and as high as wide. -->
        <FrameLayout
            android:id="@+id/widget_art_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_art_night"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/widget_night_tone"
                android:tintMode="src_in"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_art_blank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/widget_cell_light"
                android:tintMode="src_in" />

            <ImageView
                android:id="@+id/widget_art_glyph"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_track"
                android:tint="@color/widget_quiet_light"
                android:tintMode="src_in" />

            <ImageView
                android:id="@+id/widget_art_glyph_large"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_track_light"
                android:tint="@color/widget_quiet_light"
                android:tintMode="src_in"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Takes what the cover and the cells leave, so words that do not fit are cut here. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                layout="@layout/widget_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_words_lead_out"
                android:layout_marginTop="@dimen/widget_words_lead_out_top" />
        </FrameLayout>

        <include
            layout="@layout/widget_buttons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_cell_height"
            android:layout_marginStart="@dimen/widget_cell_inset_out"
            android:layout_marginEnd="@dimen/widget_cell_inset_out" />
    </LinearLayout>
</FrameLayout>
