<?xml version="1.0" encoding="utf-8"?>
<!-- A touch target sharing its row's width; the cell drawables are inset half a gap at the sides, so
     cells and gaps stay even at any size. WidgetCellsViews pads it vertically where the target is
     taller than the cell. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <!-- Separate from the target, whose padding insets the cell (hence UselessParent is ignored). -->
    <FrameLayout
        android:id="@+id/widget_cell_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:duplicateParentState="true"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_cell_inset"
            android:layout_marginEnd="@dimen/widget_cell_inset"
            android:duplicateParentState="true"
            android:foreground="@drawable/widget_face_press"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
