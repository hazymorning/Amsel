<?xml version="1.0" encoding="utf-8"?>
<!-- widget_cell at a bar's end: a target 52 dp wide, its cell 48. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_cell"
    android:layout_width="@dimen/widget_bar_cell"
    android:layout_height="match_parent">

    <!-- Not one view with the target: the target's padding keeps the cell in the frame. -->
    <FrameLayout
        android:id="@+id/widget_cell_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bare_light"
        android:duplicateParentState="true"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/widget_glyph_light"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_face"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
