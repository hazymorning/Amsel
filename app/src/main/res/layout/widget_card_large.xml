<?xml version="1.0" encoding="utf-8"?>
<!-- widget_card with its words a fifth larger, where they all have room (WidgetFit.large). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: a launcher inflates only the classes widgets may use. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_padding"
        android:paddingTop="@dimen/widget_padding_words"
        android:paddingEnd="@dimen/widget_padding"
        android:paddingBottom="@dimen/widget_padding">

        <!-- Takes what the cells leave, so words that do not fit are cut here, never the cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                layout="@layout/widget_words_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_words_lead_out" />
        </FrameLayout>

        <include
            layout="@layout/widget_buttons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_cell_height"
            android:layout_marginStart="@dimen/widget_cell_inset_out"
            android:layout_marginTop="@dimen/widget_words_to_cells"
            android:layout_marginEnd="@dimen/widget_cell_inset_out" />
    </LinearLayout>
</FrameLayout>
