<?xml version="1.0" encoding="utf-8"?>
<!-- The widget (WidgetViews fills it): its cover softly blurred under a veil, the speaker, what plays,
     and four buttons along the foot. The ids stay as they are: a launcher keeps drawn widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: a launcher inflates only the classes widgets may use. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_speaker_glyph"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speaker_bold"
                    android:tint="@color/widget_glyph_light" />

                <TextView
                    android:id="@+id/widget_speaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/widget_words_light"
                    android:textFontWeight="600"
                    android:textSize="13sp" />

                <!-- After the name, so a long name leaves it no room: the level gives way first. -->
                <TextView
                    android:id="@+id/widget_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_quiet_light"
                    android:textFontWeight="600"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3sp"
                android:maxLines="2"
                android:text="@string/player_not_playing"
                android:textColor="@color/widget_words_light"
                android:textFontWeight="700"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_quiet_light"
                android:textFontWeight="400"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_press_light">

            <ImageView
                android:id="@+id/widget_glyph_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_glyph_light" />

            <ImageView
                android:id="@+id/widget_disc_1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_disc_light"
                android:importantForAccessibility="no"
                android:padding="11.5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_thumb_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_press_light">

            <ImageView
                android:id="@+id/widget_glyph_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_disc_2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_disc_light"
                android:importantForAccessibility="no"
                android:padding="11.5dp"
                android:src="@drawable/ic_play"
                android:tint="@color/widget_on_disc_light" />

            <ImageView
                android:id="@+id/widget_thumb_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_press_light">

            <ImageView
                android:id="@+id/widget_glyph_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_glyph_light" />

            <ImageView
                android:id="@+id/widget_disc_3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_disc_light"
                android:importantForAccessibility="no"
                android:padding="11.5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_thumb_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_slot_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_press_light">

            <ImageView
                android:id="@+id/widget_glyph_4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_speaker"
                android:tint="@color/widget_glyph_light" />

            <ImageView
                android:id="@+id/widget_disc_4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_disc_light"
                android:importantForAccessibility="no"
                android:padding="11.5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_thumb_4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
