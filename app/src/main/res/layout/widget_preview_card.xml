<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing as it comes, for the picker's preview and while the widget is first drawn. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:targetApi="31">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/widget_words" />
    </FrameLayout>

    <include
        layout="@layout/widget_preview_cells"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_cell_height"
        android:layout_marginStart="@dimen/widget_cell_inset_out"
        android:layout_marginEnd="@dimen/widget_cell_inset_out" />
</LinearLayout>
