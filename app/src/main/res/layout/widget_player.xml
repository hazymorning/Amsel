<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows and more, four cells wide: the cover beside what plays, above or below a row of button
     cells. The cells and the words are added from WidgetDrawing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: a launcher inflates only the classes widgets may use. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:id="@+id/widget_cells_start"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_cell_height"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Its padding (WidgetDrawing.player) leaves it as high as the cover, which stands on the
             frame at the top, or at the foot after the cells; the words stand in its middle by their
             ink (WidgetWordsViews). -->
        <LinearLayout
            android:id="@+id/widget_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                layout="@layout/widget_art"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <!-- What the cover leaves; no weight, as the row itself is weighted. -->
            <FrameLayout
                android:id="@+id/widget_words_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/widget_words_lead_out_half"
                android:layout_marginBottom="@dimen/widget_words_lead_out_half"
                android:paddingStart="@dimen/widget_art_to_words"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_cells_end"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_cell_height"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
