<?xml version="1.0" encoding="utf-8"?>
<!-- The cells and the text are added by WidgetDrawing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: RemoteViews inflate only the classes allowed in widgets. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:id="@+id/widget_cells_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- WidgetDrawing.player pads it to the cover's height, so the cover meets the frame; the text
             is centred in it by its visible bounds. -->
        <LinearLayout
            android:id="@+id/widget_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                layout="@layout/widget_art"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <!-- match_parent takes what the cover leaves; a weight would nest inside the weighted row. -->
            <FrameLayout
                android:id="@+id/widget_words_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/widget_words_lead_out_half"
                android:layout_marginBottom="@dimen/widget_words_lead_out_half"
                android:paddingStart="@dimen/widget_art_to_words"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_cells_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
