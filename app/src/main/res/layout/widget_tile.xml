<?xml version="1.0" encoding="utf-8"?>
<!-- One cell, all of it the button: its cell in the frame, as every other form's, or a cover. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: a launcher inflates only the classes widgets may use. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_face_night"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:tint="@color/widget_night_tone"
        android:tintMode="src_in"
        android:visibility="gone" />

    <!-- The button's cell in the frame; pressed with the tile, which is all of it the button. -->
    <FrameLayout
        android:id="@+id/widget_tile_cell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/widget_tile_side"
        android:layout_marginTop="@dimen/widget_padding"
        android:layout_marginEnd="@dimen/widget_tile_side"
        android:layout_marginBottom="@dimen/widget_padding"
        android:background="@drawable/widget_cell_play_light"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/widget_tile_glyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            android:tint="@color/widget_on_disc_light"
            android:tintMode="src_in" />
    </FrameLayout>
</FrameLayout>
