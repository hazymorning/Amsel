<?xml version="1.0" encoding="utf-8"?>
<!-- The cells and the text are added by WidgetDrawing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: RemoteViews inflate only the classes allowed in widgets. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/widget_padding">

        <!-- Negative margins: the 52dp targets reach half a gap into the frame at the row's end, and
             the row reaches to 4dp from the edge above and below (WidgetSizes.REACH), so a low bar's
             targets keep their height (WidgetDrawing.bar). -->
        <LinearLayout
            android:id="@+id/widget_cells_start"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_cell_inset_out"
            android:layout_marginTop="@dimen/widget_reach_out"
            android:layout_marginBottom="@dimen/widget_reach_out"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone" />

        <include
            layout="@layout/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/widget_words_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/widget_words_lead_out_half"
            android:layout_marginBottom="@dimen/widget_words_lead_out_half"
            android:paddingStart="@dimen/widget_art_to_words"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:id="@+id/widget_cells_end"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/widget_reach_out"
            android:layout_marginEnd="@dimen/widget_cell_inset_out"
            android:layout_marginBottom="@dimen/widget_reach_out"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
