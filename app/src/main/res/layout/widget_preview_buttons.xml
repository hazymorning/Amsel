<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    android:paddingStart="@dimen/widget_padding"
    android:paddingEnd="@dimen/widget_padding"
    tools:targetApi="31">

    <include
        layout="@layout/widget_preview_cells"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_cell_height"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/widget_cell_inset_out"
        android:layout_marginEnd="@dimen/widget_cell_inset_out" />
</FrameLayout>
