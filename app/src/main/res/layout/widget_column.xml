<?xml version="1.0" encoding="utf-8"?>
<!-- Card, Line and Poster. WidgetDrawing sets the paddings and adds the cells and the text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cover"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- An ImageView, not a View: RemoteViews inflate only the classes allowed in widgets. -->
    <ImageView
        android:id="@+id/widget_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <!-- Negative margins span the widget's width; WidgetDrawing's padding keeps the cells in the frame. -->
        <LinearLayout
            android:id="@+id/widget_cells_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Weighted, so text that does not fit is clipped here, never the cells. -->
        <LinearLayout
            android:id="@+id/widget_part"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_art_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/widget_art_to_words_lead"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_art_night"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:tint="@color/widget_night_tone"
                    android:tintMode="src_in"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_art_blank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:tint="@color/widget_cell_light"
                    android:tintMode="src_in" />

                <ImageView
                    android:id="@+id/widget_art_glyph"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_track"
                    android:tint="@color/widget_quiet_light"
                    android:tintMode="src_in" />

                <ImageView
                    android:id="@+id/widget_art_glyph_large"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_track_light"
                    android:tint="@color/widget_quiet_light"
                    android:tintMode="src_in"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_words_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_cells_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_out"
            android:layout_marginEnd="@dimen/widget_padding_out"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
