<?xml version="1.0" encoding="utf-8"?>
<!-- Half a gap above and below, as the cell drawables have at the sides; WidgetDrawing.pad counts on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pad_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="@dimen/widget_cell_inset"
    android:paddingBottom="@dimen/widget_cell_inset" />
