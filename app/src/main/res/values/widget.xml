<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Before Android 12 launchers do not round widgets. -->
    <dimen name="widget_radius">0dp</dimen>
    <!-- Android's system_app_widget_internal_padding; WidgetSizes.PADDING. -->
    <dimen name="widget_padding">16dp</dimen>
    <dimen name="widget_padding_out">-16dp</dimen>
    <!-- To WidgetSizes.REACH (4dp) from the edge, for bare buttons and a low row's targets. -->
    <dimen name="widget_reach_out">-12dp</dimen>
    <!-- Half of WidgetSizes.GAP: a cell's inset in its touch target, and how far a row of targets
         reaches into the frame. -->
    <dimen name="widget_cell_inset">2dp</dimen>
    <dimen name="widget_cell_inset_out">-2dp</dimen>
    <dimen name="widget_bar_cell">52dp</dimen>
    <!-- The padding less the cell drawables' 2dp side inset, so a tile's cell meets the frame. -->
    <dimen name="widget_tile_side">14dp</dimen>
    <dimen name="widget_cell_height">56dp</dimen>
    <dimen name="widget_cell_gap">4dp</dimen>
    <!-- WidgetSizes.LEAD: the text view stands this far outside its box; WidgetWordsViews pads each
         line back in. -->
    <dimen name="widget_words_lead_out">-6dp</dimen>
    <dimen name="widget_words_lead">6dp</dimen>
    <!-- Centred text may overflow the frame by half the lead above and below (centred, in
         WidgetFit.kt's said()). -->
    <dimen name="widget_words_lead_out_half">-3dp</dimen>
    <dimen name="widget_art_to_words">12dp</dimen>
    <!-- widget_art_to_words less the lead, which the text box adds above the cap top. -->
    <dimen name="widget_art_to_words_lead">6dp</dimen>
    <!-- Concentric with a 28dp widget corner: 28 less the 16dp padding. -->
    <dimen name="widget_cell_radius">12dp</dimen>
</resources>
