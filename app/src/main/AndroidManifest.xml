<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- An update installs from Amsel itself: Android's installer refuses an app without this. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- AndroidX core declares these for receivers registered not exported below Android 13; none is
         (Media3's car observer registers its receiver exported). -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- tools:targetApi: the attributes newer than minSdk are ignored by older Android versions. -->
    <application
        android:name=".AmselApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amsel.Starting"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play X on Amsel" from the assistant. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- amsel://search, amsel://now-playing, amsel://up-next, amsel://speakers and amsel://group
                 (Opening): for the launcher's shortcuts and Amsel's widgets, and for a widget such as
                 KWGT, which opens them as links. They only open a screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="amsel" />
                <data android:host="search" />
                <data android:host="now-playing" />
                <data android:host="up-next" />
                <data android:host="speakers" />
                <data android:host="group" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- A widget's page: the launcher opens it to change the widget, and on older Androids as it is placed. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Amsel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- The widget, three ways in by the size it starts at; the first keeps its name, so placed ones stay. -->
        <receiver
            android:name=".widget.AmselButtonWidget"
            android:exported="false"
            android:label="@string/widget_name_button">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_button_info" />
        </receiver>
        <receiver
            android:name=".widget.AmselButtonsWidget"
            android:exported="false"
            android:label="@string/widget_name_buttons">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buttons_info" />
        </receiver>
        <receiver
            android:name=".widget.AmselWidget"
            android:exported="false"
            android:label="@string/widget_name_now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- The widget's buttons; only its own pending intents reach it. -->
        <receiver
            android:name=".widget.WidgetTaps"
            android:exported="false" />
        <!-- The widgets' looks at the speakers while Amsel's socket is closed (JobScheduler binds it). -->
        <service
            android:name=".widget.WidgetLooks"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The car's artwork: not exported, the car is granted reading it when it connects. -->
        <provider
            android:name=".app.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- A downloaded update: not exported, the installer is granted reading it when it opens. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/updates" />
        </provider>
    </application>
</manifest>
