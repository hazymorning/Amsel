<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- In-app updates: the package installer refuses an app without it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- AndroidX core adds these for receivers registered not exported below Android 13, and ContextCompat
         throws without them: none may be (Media3's car observer registers its receiver exported). -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- tools:targetApi: the attributes newer than minSdk are ignored by older Android versions. -->
    <application
        android:name=".AmselApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amsel.Starting"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Shortcuts and widgets, KWGT's too, open these (DeepLink); a link only ever opens a screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="amsel" />
                <data android:host="search" />
                <data android:host="now-playing" />
                <data android:host="up-next" />
                <data android:host="speakers" />
                <data android:host="group" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Amsel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- One widget at three starting sizes. AmselWidget keeps its original name, so placed widgets stay. -->
        <receiver
            android:name=".widget.AmselButtonWidget"
            android:exported="false"
            android:label="@string/widget_name_button">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_button_info" />
        </receiver>
        <receiver
            android:name=".widget.AmselButtonsWidget"
            android:exported="false"
            android:label="@string/widget_name_buttons">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buttons_info" />
        </receiver>
        <receiver
            android:name=".widget.AmselWidget"
            android:exported="false"
            android:label="@string/widget_name_now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WidgetTapReceiver"
            android:exported="false" />
        <service
            android:name=".widget.WidgetRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Not exported: the car is granted read access when it connects (CarArtwork.allow). -->
        <provider
            android:name=".app.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".app.UpdateResultReceiver"
            android:exported="false" />
    </application>
</manifest>
